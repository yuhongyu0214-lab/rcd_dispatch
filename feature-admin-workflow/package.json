{
  "name": "dispatch-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dispatch-events": "node scripts/dispatch-event-worker.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev --name data_model_core",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.7.0",
    "bcrypt": "^6.0.0",
    "ioredis": "^5.4.1",
    "next": "15.5.21",
    "pino": "9.6.0",
    "prisma": "^6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^7.4.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.18",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "3.2.6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.14": "1.1.17",
      "brace-expansion@5.0.5": "5.0.8",
      "next@15.5.21>sharp": "-",
      "postcss": "8.5.18",
      "tsx@4.21.0>esbuild": "0.28.1",
      "vite": "6.4.3"
    }
  }
