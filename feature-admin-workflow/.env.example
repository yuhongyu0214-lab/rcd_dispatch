DATABASE_URL="postgresql://username:password@localhost:5432/dispatch_system"
SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/dispatch_shadow"
AUTH_SESSION_SECRET="replace-with-a-generated-secret"
DRIVER_JWT_SECRET="replace-with-a-separate-generated-secret"
AMAP_SERVER_KEY="replace-with-your-amap-server-key"
NEXT_PUBLIC_AMAP_JS_KEY="replace-with-your-amap-js-key"
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE="replace-with-your-amap-security-js-code"
REDIS_URL="redis://localhost:6379"
# REDIS_URL 配置后此项必填；预生产固定使用 rcd:v2:preprod:
REDIS_KEY_PREFIX="rcd:v2:dev:"
INTERNAL_CRON_SECRET="replace-with-a-generated-worker-secret"
DISPATCH_EVENT_WORKER_ORIGIN="https://dispatch.example.com"
LOG_LEVEL="info"
INGEST_API_KEY="replace-with-a-generated-ingest-key"
INGEST_API_KEY_SOURCE="HALUO"
CORS_ORIGINS="chrome-extension://your-extension-id"
ALLOW_PUBLIC_ADMIN_REGISTRATION="false"
# 仅精确值 true 表示 V2 状态机已成为唯一事实入口，并停用兼容矩阵列出的 V1 业务写接口。
RCD_V2_STATE_MACHINE_ENABLED="false"
